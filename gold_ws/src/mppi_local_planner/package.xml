<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mppi_local_planner</name>
  <version>0.1.0</version>
  <description>
    금색차 kasa 용 MPPI 로컬 장애물 회피. catkin_ws/src/mppi_local_planner
    (1/5카용) 를 이식했다. 전역경로 없이 라이다 + IMU 만으로 직진하다가
    장애물을 감아 피하고 IMU 기준선으로 돌아온다. 액추에이터 계약
    (펄스·pot 지령·부호·리니어)은 include/mppi_local_planner/kasa_units.hpp
    가 lidar 패키지 정본의 스냅샷이다.
  </description>
  <maintainer email="vk1124x@gmail.com">cheongbaek</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- 실행 의존 : 코드를 링크하지 않고 토픽·런치만 쓴다.
         nxde   : /cmd_vel_raw · /control_state · /brake_level 수신
         lidar  : ouster.launch.py (OS1-32 드라이버 설정 정본)
         white1 : hud · 음성 음원 -->
  <exec_depend>nxde</exec_depend>
  <exec_depend>lidar</exec_depend>
  <exec_depend>white1</exec_depend>
  <exec_depend>ouster_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
