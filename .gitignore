# ROS2 colcon 빌드 산출물 (colcon build 로 재생성 가능)
build/
install/
log/

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# CSV 기본은 막는다 — 매 실행마다 쌓이는 계측 데이터가 소스 diff 를 묻지 않게.
#   ★단 white1 의 두 폴더는 아래에서 예외로 연다★ (gps_data = 주행 입력,
#   ros2bag = 판단 근거). 막히는 것은 그 밖의 CSV 뿐이다.
*.csv

# ★예외 : white1/gps_data 의 경로 CSV 는 추적한다★ [2026-09-07]
#   위 *.csv 규칙은 '매 실행마다 쌓이는 계측 데이터' 를 막으려는 것인데, 이 폴더는
#   ★차가 따라갈 경로(맵)★ 를 담는다 — driving·prompt 가 읽는 입력이고, 없으면
#   런치를 띄워도 고를 경로가 없다. 새로 clone 한 기계에서 곧바로 주행하려면
#   이력에 있어야 한다(paths.py data_dir() 이 이 폴더를 소스트리에서 찾는다).
#   ⚠️ ★이 폴더에는 mapping 이 새로 딴 경로도 그대로 쌓인다★ — 그것까지 자동으로
#     추적 대상이 되므로, 시험 삼아 딴 경로는 커밋 전에 지우거나 빼고 올릴 것.
#     white806/gps_data 는 종전대로 막혀 있다.
!gold_ws/src/white1/gps_data/*.csv

# ★예외 2 : white1/ros2bag 의 주행 기록 CSV 도 추적한다★ [2026-09-13]
#   종전에는 '매 실행마다 쌓이는 계측 데이터' 로 보고 막았는데, 실제로 이 저장소에서
#   ★판단의 근거가 되는 것이 거의 전부 이 파일들★ 이다 — 조향 영점 −3.00°,
#   CTE 부호 편향 73~80%, 제동 감속도 4.0~4.2 m/s², LFD 분포, 라이다 감지거리…
#   전부 이 CSV 를 다시 읽어서 나온 수치이고, 다른 기계에서 같은 결론을 재현하려면
#   그 파일이 있어야 한다. ★수치를 문서에 옮겨 적는 것만으로는 재검산이 안 된다.★
#   (2026-09-13 기준 116개 / 117MB. CSV 는 텍스트라 git 압축이 잘 듣는다.)
#   ⚠️ ★그래서 이 폴더도 `git add -A` 의 사정권이다★ — 0.3절의 경고가 이제 두 폴더에
#     걸린다. 시험 삼아 돌린 기록은 커밋 전에 빼거나 지울 것.
#   ⚠️ 한 파일이 100MB 를 넘으면 GitHub 가 거부한다. 긴 주행은 확인하고 올릴 것.
!gold_ws/src/white1/ros2bag/*.csv

# ★사무용 프로그램의 임시·락 파일★ [2026-09-13]
#   CSV 를 LibreOffice 로 열어 두면 같은 폴더에 `.~lock.<이름>#` 이 생긴다.
#   위 예외 두 줄이 그것까지 추적 대상으로 끌어올리므로 여기서 되막는다.
.~lock.*#
~$*

# 음성 안내 음원 (nxde/sound/*.mp3) — CSV 와 같은 취급으로 추적하지 않는다
#   ⚠️ 새로 clone 하면 sound/ 가 비어 있다. sound 노드는 '음원 없음' 경고만 남기고
#     조용히 도는데, 안내가 필요하면 `ros2 run nxde tts` 로 다시 만들면 된다.
*.mp3

# 녹화 영상 (nxde video 노드 산출물)
#   · white1/video/tl-<시각>.mp4  ★신호등 인지 디버그 화면★ — one_launch·master.launch
#     가 주행 내내 자동으로 적는다(tl_record_video, 기본 켜짐). ★그래서 제일 빨리 쌓인다★
#   · nxde/video/cam-<시각>.mp4   `ros2 run nxde video` 로 손수 적는 원본 화면
#   CSV·스크린샷과 같은 이유다. 1080p 가 ★분당 20~60MB★ 라 몇 번만 돌려도 GB 가 되고,
#   git 이력에 들어가면 되돌릴 수 없다. 파일은 작업트리에 그대로 남는다.
#   ※ 남겨야 하는 장면이면 잘라서 별도로 보관하고, 판정 근거는 문서에 수치로 적는다.
*.mp4
*.avi
*.mkv
*.mov

# 디버그 화면 캡처 — CSV 와 같은 이유로 이력에 넣지 않는다
#   신호등·정지선 인지를 볼 때 화면을 찍어 두는데, 한 장이 2~3MB 라 git 이력에
#   영구히 남으면 소스 저장소가 계측 자료실이 된다. 파일은 작업트리에 그대로 남는다.
#   ※ 시험 결과로 ★남겨야 하는 그림★ 이면 STOPLINE_TEST.md 같은 문서에 수치로 적는다.
*.png
*.jpg
*.jpeg

# ouster 드라이버가 실행 위치에 떨구는 메타데이터 (config 로 ~/.ros 에 고정했지만
# 드라이버를 직접 띄우면 여전히 cwd 에 생긴다 — 센서 정체는 config/ 사본이 갖는다)
*-metadata.json
